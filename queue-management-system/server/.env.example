# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/queue_management"

# Server
PORT=3000

# Africa's Talking (USSD) -- fill in once you have sandbox credentials
AT_USERNAME=sandbox
AT_API_KEY=

# WhatsApp Cloud API -- fill in once you have a Meta developer app
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
